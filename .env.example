# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=secrets_manager

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (for secret values — must be 32 chars)
ENCRYPTION_KEY=your_32_character_encryption_key_

# ImageKit (avatars)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Default avatar (set on registration)
DEFAULT_AVATAR_URL=https://ik.imagekit.io/your_id/avatars/default.png
DEFAULT_AVATAR_PUBLIC_ID=
